---
/** Base layout: fonts, styles, skip link, crisis strip, header, main, footer. */
import '@fontsource/archivo/latin-800.css';
import '@fontsource-variable/public-sans/wght.css';
import '../styles/tokens.css';
import '../styles/base.css';
import SeoHead from '../components/SeoHead.astro';
import CrisisStrip from '../components/CrisisStrip.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
interface Props { title: string; description: string; noindex?: boolean; footerContact?: boolean }
const { title, description, noindex = false, footerContact = true } = Astro.props;
---
<!doctype html>
<html lang="en-GB" class="no-js">
  <head>
    <script is:inline>document.documentElement.classList.remove('no-js');</script>
    <SeoHead title={title} description={description} noindex={noindex} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <CrisisStrip />
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer showContact={footerContact} />
  </body>
</html>
