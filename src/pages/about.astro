---
import BaseLayout from '../layouts/BaseLayout.astro';
import Photo from '../components/Photo.astro';
import { hasPhoto } from '../lib/photos';
import { about } from '../content/pages/about';
const { hero, story, areNot, approach, values } = about;
const withPortrait = hasPhoto('about-founder');
---
<BaseLayout title={about.meta.title} description={about.meta.description}>
  <section class="hero tone-dark" aria-labelledby="about-title">
    <div class:list={['container', withPortrait && 'hero-split']}>
      <div>
        <p class="eyebrow">{hero.eyebrow}</p>
        <h1 id="about-title" class="hero-title">{hero.title}</h1>
        <p class="lead hero-lead">{hero.lead}</p>
      </div>
      <Photo slot="about-founder" loading="eager" class="hero-photo" />
    </div>
  </section>

  <section id="our-story" class="story tone-panel section" aria-labelledby="story-title">
    <div class="container split split-narrow-wide">
      <h2 id="story-title">{story.heading}</h2>
      <div class="story-body">
        {story.paragraphs.map((p) => <p>{p}</p>)}
        <p>{story.closingLead} <strong class="story-question">{story.question}</strong></p>
      </div>
    </div>
  </section>

  <section class="are-not tone-light section" aria-labelledby="are-not-title">
    <div class="container">
      <h2 id="are-not-title" class="measure">{areNot.heading}</h2>
      <div class="are-not-grid">
        {[{ ...areNot.are, cls: 'label-are' }, { ...areNot.not, cls: 'label-not' }].map((col) => (
          <div class="card tone-card are-not-card">
            <h3 class:list={['eyebrow', col.cls]}>{col.label}</h3>
            <ul class="bullets">{col.items.map((i) => <li>{i}</li>)}</ul>
          </div>
        ))}
      </div>

      <div class="approach split split-narrow-wide">
        <div>
          <h2>{approach.heading}</h2>
          <p class="measure">{approach.lead}</p>
        </div>
        <ol class="commitments">
          {approach.commitments.map((c, i) => (
            <li>
              <span class="num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <p><strong>{c.title}</strong> {c.text}</p>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <section class="values tone-alt section" aria-labelledby="values-title">
    <div class="container">
      <h2 id="values-title">{values.heading}</h2>
      <ul class="values-grid">
        {values.items.map((v) => (
          <li>
            <h3 class="value-name">{v.name}</h3>
            <p>{v.line}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>
<style>
  .hero { padding-block: clamp(3.5rem, 2rem + 5vw, 6.5rem); }
  .hero-split { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 4fr); gap: var(--space-5); align-items: center; }
  .hero-title { max-width: 15ch; margin-bottom: 1.75rem; }
  .hero-lead { max-width: 34rem; }

  .story h2 { margin: 0; }
  .story-body p { color: var(--body); }
  .story-question { color: var(--head); }

  .are-not h2 { margin-bottom: var(--space-4); }
  .are-not-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
  .are-not-card { padding: 2rem 1.75rem; }
  .are-not-card .bullets { font-size: 1rem; }
  .label-are { color: var(--teal); }
  .label-not { color: var(--amber-text); }

  .approach { margin-top: var(--space-6); }
  .approach h2 { margin-bottom: 1rem; }
  .commitments { list-style: none; border-top: 1px solid var(--rule); }
  .commitments li { display: grid; grid-template-columns: 2.75rem minmax(0, 1fr); gap: 0.75rem; padding-block: 1.25rem; border-bottom: 1px solid var(--rule); }
  .commitments p { font-size: 1.0625rem; margin: 0; }
  .commitments strong { color: var(--head); }
  .num { font-family: var(--font-head); font-weight: 800; color: var(--teal); font-size: 1.0625rem; line-height: 1.6; }

  .values h2 { margin-bottom: var(--space-4); }
  .values-grid { list-style: none; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1.5rem; }
  .values-grid li { border-top: 2px solid var(--light-heading); padding-top: 1rem; }
  .value-name { font-size: 1.25rem; margin-bottom: 0.35rem; }
  .values-grid p { font-size: 1rem; }

  @media (max-width: 900px) {
    .hero-split { grid-template-columns: minmax(0, 1fr); }
    .values-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 680px) { .are-not-grid { grid-template-columns: minmax(0, 1fr); } }
  @media (max-width: 480px) { .values-grid { grid-template-columns: minmax(0, 1fr); } }
</style>
