---
import BaseLayout from '../layouts/BaseLayout.astro';
import { partners } from '../content/pages/partners';
const { hero, offer, ways, who, boundary } = partners;
---
<BaseLayout title={partners.meta.title} description={partners.meta.description}>
  <section class="hero tone-dark" aria-labelledby="partners-title">
    <div class="container">
      <p class="eyebrow">{hero.eyebrow}</p>
      <h1 id="partners-title" class="hero-title">{hero.title}</h1>
      <p class="lead hero-lead">{hero.lead}</p>
      <div class="button-row">
        <a class="button button-amber" href={hero.primaryCta.href}>{hero.primaryCta.label}</a>
        <a class="button button-ghost" href={hero.secondaryCta.href}>{hero.secondaryCta.label}</a>
      </div>
    </div>
  </section>

  <section class="tone-light section" aria-labelledby="offer-title">
    <div class="container">
      <h2 id="offer-title">{offer.heading}</h2>
      <ul class="offer-grid">
        {offer.items.map((o) => (
          <li class="card tone-card">
            <h3 class="card-title">{o.title}</h3>
            <p>{o.text}</p>
          </li>
        ))}
      </ul>

      <div class="ways split split-narrow-wide">
        <h2>{ways.heading}</h2>
        <ul class="ways-list">{ways.items.map((w) => <li>{w}</li>)}</ul>
      </div>
    </div>
  </section>

  <section class="tone-alt section" aria-labelledby="who-title">
    <div class="container">
      <h2 id="who-title">{who.heading}</h2>
      <ul class="who-grid">
        {who.items.map((w) => (
          <li>
            <h3 class="card-title">{w.title}</h3>
            <p>{w.text}</p>
          </li>
        ))}
      </ul>
      <div class="boundary card-dark tone-panel">
        <h2 class="boundary-title">{boundary.heading}</h2>
        <p>{boundary.text}</p>
      </div>
    </div>
  </section>
</BaseLayout>
<style>
  .hero { padding-block: clamp(3.5rem, 2rem + 5vw, 6.5rem); }
  .hero-title { max-width: 16ch; margin-bottom: 1.5rem; }
  .hero-lead { max-width: 36rem; margin-bottom: 2.25rem; }

  .offer-grid { list-style: none; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1rem; margin-top: var(--space-4); }
  .card-title { font-size: 1.25rem; margin-bottom: 0.6rem; }
  .offer-grid p, .who-grid p { font-size: 1rem; }

  .ways { margin-top: var(--space-6); }
  .ways h2 { margin: 0; }
  .ways-list { list-style: none; border-top: 1px solid var(--rule); }
  .ways-list li { padding-block: 1rem; border-bottom: 1px solid var(--rule); font-family: var(--font-head); font-weight: 800; font-size: 1.25rem; color: var(--head); }

  .who-grid { list-style: none; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.5rem; margin-top: var(--space-4); }
  .who-grid li { border-top: 2px solid var(--light-heading); padding-top: 1rem; }

  .boundary { margin-top: var(--space-6); padding: clamp(1.75rem, 1rem + 2.5vw, 2.75rem); }
  .boundary-title { font-size: clamp(1.5rem, 1.3rem + 0.8vw, 2rem); margin-bottom: 0.75rem; }
  .boundary p { max-width: 44rem; }

  @media (max-width: 1000px) { .offer-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 760px) { .who-grid { grid-template-columns: minmax(0, 1fr); } }
  @media (max-width: 560px) { .offer-grid { grid-template-columns: minmax(0, 1fr); } }
</style>
