---
/** Site header: logo left, navigation, Let's Talk button right. Collapses to a menu below 900px. */
import { primaryNav, primaryCta } from '../config/navigation';
import Logo from './Logo.astro';
import Button from './Button.astro';
import Icon from './Icon.astro';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => href === path;
---
<header class="site-header">
  <div class="container header-inner">
    <Logo />
    <nav class="site-nav" id="site-menu" aria-label="Main">
      <ul class="nav-list">
        {primaryNav.map((item) => (
          <li>
            <a href={item.href} class="nav-link" aria-current={!item.isAnchor && isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>
    <div class="header-actions">
      <Button href={primaryCta.href} label={primaryCta.label} variant="primary" arrow={false} class="header-cta" ariaCurrent={isCurrent(primaryCta.href) ? 'page' : undefined} />
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-menu">
        <span class="visually-hidden">Menu</span>
        <Icon name="menu" size={22} strokeWidth={2} class="ico-open" />
        <Icon name="x" size={22} strokeWidth={2} class="ico-close" />
      </button>
    </div>
  </div>
</header>
<script>
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const menu = document.getElementById('site-menu');
  if (toggle && menu) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      document.body.classList.toggle('menu-open', open);
      menu.classList.toggle('is-open', open);
    };
    toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') { setOpen(false); toggle.focus(); }
    });
    window.matchMedia('(min-width: 901px)').addEventListener('change', (e) => { if (e.matches) setOpen(false); });
  }
</script>
<style>
  .site-header { background: var(--cream); position: relative; z-index: 20; }
  .header-inner { display: flex; align-items: center; justify-content: space-between; gap: var(--space-3); min-height: 84px; }
  .nav-list { display: flex; list-style: none; gap: clamp(0.75rem, 0.4rem + 1vw, 1.5rem); align-items: center; }
  .nav-link { display: inline-flex; align-items: center; min-height: 44px; padding: 0 0.15rem; font-size: 0.9375rem; font-weight: 500; color: var(--ink); text-decoration: none; border-bottom: 2px solid transparent; border-radius: 0; }
  .nav-link:hover { color: var(--teal); }
  .nav-link[aria-current='page'] { border-bottom-color: var(--teal); font-weight: 600; }
  .header-actions { display: flex; align-items: center; gap: var(--space-2); }
  .menu-toggle { display: none; align-items: center; justify-content: center; width: 44px; height: 44px; background: transparent; border: 1.5px solid var(--rule); border-radius: 10px; color: var(--ink); cursor: pointer; }
  .menu-toggle[aria-expanded='true'] :global(.ico-open) { display: none; }
  .menu-toggle[aria-expanded='false'] :global(.ico-close) { display: none; }
  @media (max-width: 900px) {
    .menu-toggle { display: inline-flex; }
    .site-nav { display: none; position: absolute; left: 0; right: 0; top: 100%; background: var(--cream); border-top: 1px solid var(--rule); border-bottom: 1px solid var(--rule); padding: var(--space-2) var(--gutter) var(--space-3); box-shadow: 0 16px 24px -16px rgba(22,55,68,0.25); }
    .site-nav.is-open { display: block; }
    .nav-list { flex-direction: column; align-items: stretch; gap: 0; }
    .nav-link { min-height: 48px; font-size: 1.0625rem; padding: 0 0.25rem; border-bottom: 1px solid var(--rule); width: 100%; }
    .nav-link[aria-current='page'] { border-bottom: 1px solid var(--rule); color: var(--teal); }
  }
  @media (max-width: 400px) { :global(.header-cta) { padding-inline: 1rem; } }
</style>
