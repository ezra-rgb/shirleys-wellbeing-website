---
/** About: "Our story". Optional founder image slot renders only when supplied (decision OD4). */
import ImageSlot from './ImageSlot.astro';
import Button from './Button.astro';
import Statement from './Statement.astro';
interface Props { heading: string; subheading: string; paragraphs: string[]; pullLine: string; cta?: { label: string; href: string }; id?: string }
const { heading, subheading, paragraphs, pullLine, cta, id = 'our-story' } = Astro.props;
---
<div class="story" id={id}>
  <ImageSlot name="about-story" hideIfMissing class="story-image" />
  <h2 class="story-heading">{heading}</h2>
  <p class="subhead-coral">{subheading}</p>
  {paragraphs.map((p) => <p>{p}</p>)}
  {cta && <div class="story-cta"><Button href={cta.href} label={cta.label} variant="secondary" /></div>}
  <Statement variant="pull" text={pullLine} />
</div>
<style>
  .story p { max-width: 46ch; }
  .story-heading { font-size: clamp(2.25rem, 1.6rem + 2.2vw, 3.25rem); }
  .story :global(.story-image) { border-radius: var(--radius-card); max-width: 22rem; margin-bottom: var(--space-3); }
  .story-cta { margin-top: var(--space-2); }
</style>
