---
/** Let's Talk: "Who can get in touch?" five tinted cards from src/content/audiences. */
import { getCollection } from 'astro:content';
import Icon from './Icon.astro';
interface Props { heading: string; lead: string; id?: string }
const { heading, lead, id = 'who' } = Astro.props;
const audiences = (await getCollection('audiences')).sort((a, b) => a.data.order - b.data.order);
---
<section id={id} class="audiences" aria-labelledby={`${id}-heading`}>
  <div class="container">
    <h2 id={`${id}-heading`}>{heading}</h2>
    <p class="aud-lead">{lead}</p>
    <ul class="grid grid-5 aud-list">
      {audiences.map((a) => (
        <li class={`aud tint-${a.data.tint}`} id={a.data.anchor}>
          <Icon name={a.data.icon} size={40} strokeWidth={1.5} class={`aud-icon ic-${a.data.iconColour}`} />
          <h3 class="aud-title">{a.data.title}</h3>
          <p class="aud-summary">{a.data.summary}</p>
          {a.data.href && <a class="text-link" href={a.data.href}>Find out more<span class="visually-hidden"> about {a.data.title}</span></a>}
        </li>
      ))}
    </ul>
  </div>
</section>
<style>
  .audiences { padding-block: var(--space-section); }
  .aud-lead { margin-bottom: var(--space-3); }
  .aud-list { list-style: none; }
  .aud { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 0.4rem; padding: var(--space-3) var(--space-2); border-radius: var(--radius-card); }
  .aud-title { font-family: var(--font-sans); font-size: 1rem; font-weight: 700; margin: 0; }
  .aud-summary { font-size: var(--fs-small); margin: 0; }
  .ic-coral { color: var(--coral); } .ic-teal { color: var(--teal); } .ic-sage { color: var(--sage-700); } .ic-gold { color: var(--gold-700); }
  .tint-sage { background: var(--sage-200); } .tint-blush { background: var(--blush); } .tint-pale-blue { background: var(--pale-blue); } .tint-gold { background: var(--gold); }
</style>
