---
/** About: image left with handwritten overlay, approach text and step chain centre, accent right. */
import ImageSlot from './ImageSlot.astro';
import Handwritten from './Handwritten.astro';
import StepChain from './StepChain.astro';
import Button from './Button.astro';
import { imageSlots, type ImageSlotDef } from '../config/images';
interface Props { heading: string; paragraphs: string[]; steps: string[]; cta: { label: string; href: string }; imageAccent?: string; accent?: string; id?: string }
const { heading, paragraphs, steps, cta, imageAccent, accent, id = 'approach' } = Astro.props;
const baked = Boolean((imageSlots['about-approach'] as ImageSlotDef).bakedAccent);
---
<section id={id} class="approach" aria-labelledby={`${id}-heading`}>
  <div class="approach-media">
    <ImageSlot name="about-approach" fill>
      {imageAccent && !baked && <div class="approach-image-accent"><Handwritten text={imageAccent} tone="white" size="md" rotate={-8} align="left" /></div>}
    </ImageSlot>
  </div>
  <div class="approach-text">
    <h2 id={`${id}-heading`}>{heading}</h2>
    {paragraphs.map((p) => <p class="small">{p}</p>)}
    <StepChain steps={steps} />
    <div class="approach-cta"><Button href={cta.href} label={cta.label} variant="secondary" /></div>
  </div>
  {accent && <div class="approach-accent accent-side"><span class="rule-v"></span><Handwritten text={`\u201C${accent}\u201D`} size="md" rotate={-8} /></div>}
</section>
<style>
  .approach { display: grid; grid-template-columns: 45fr 40fr 15fr; background: var(--band); }
  .approach-media { position: relative; }
  .approach-image-accent { position: absolute; left: 6%; top: 12%; }
  .supplied .approach-image-accent { text-shadow: 0 1px 3px rgba(0,0,0,0.35); }
  .approach-text { padding: var(--space-5) clamp(1.5rem, 1rem + 2vw, 3rem); }
  .approach-text p { max-width: 44ch; }
  .approach-cta { margin-top: var(--space-2); }
  .approach-accent { padding: var(--space-5) var(--gutter) var(--space-5) 0; }
  @media (max-width: 900px) { .approach-accent { padding-block: 0 var(--space-4); } }
  @media (max-width: 900px) { .approach { grid-template-columns: 1fr; } .approach-text { padding-inline: var(--gutter); } }
</style>
