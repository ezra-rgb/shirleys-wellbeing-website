---
/** Text wordmark used until a final logo file is supplied. */
interface Props { href?: string }
const { href = '/' } = Astro.props;
---
<a class="wordmark" href={href} aria-label="Shirley's Wellbeing CIC, home">
  <span class="wm-name" aria-hidden="true">Shirley's</span>
  <span class="wm-sub" aria-hidden="true">Wellbeing CIC</span>
</a>
<style>
  .wordmark { display: inline-flex; flex-direction: column; justify-content: center; min-height: 44px; text-decoration: none; color: var(--dark-text); line-height: 1; }
  .wm-name { font-family: var(--font-head); font-weight: 800; font-size: 1.375rem; letter-spacing: -0.02em; }
  .wm-sub { font-size: 0.6875rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--dark-secondary); margin-top: 0.3rem; }
</style>
