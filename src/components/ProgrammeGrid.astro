---
/** "What we're building": programmes flagged showOnHome, from the programmes collection. */
import { getCollection } from 'astro:content';
import { site } from '../config/site';
import ProgrammeCard from './ProgrammeCard.astro';
import Button from './Button.astro';
interface Props { heading: string; intro: string; viewAll: { label: string; href: string }; id?: string }
const { heading, intro, viewAll, id = 'what-we-do' } = Astro.props;
const programmes = (await getCollection('programmes')).filter((p) => p.data.showOnHome).sort((a, b) => a.data.order - b.data.order);
---
<section id={id} class="building" aria-labelledby={`${id}-heading`}>
  <div class="container">
    <div class="building-head">
      <div>
        <h2 id={`${id}-heading`}>{heading}</h2>
        <p class="building-intro">{intro}</p>
      </div>
      {site.flags.showViewAllProgrammes && <Button href={viewAll.href} label={viewAll.label} variant="text" class="building-all" />}
    </div>
    <div class="grid grid-4">
      {programmes.map((p) => <ProgrammeCard programme={p} />)}
    </div>
  </div>
</section>
<style>
  .building { background: var(--band); padding-block: var(--space-section); }
  .building-head { display: flex; justify-content: space-between; align-items: flex-start; gap: var(--space-3); margin-bottom: var(--space-3); }
  .building-intro { max-width: 60ch; margin: 0; }
  .building-all { flex: none; }
  @media (max-width: 640px) { .building-head { flex-direction: column; } }
</style>
