---
/**
 * Highlighted statement system. Reproduces the mock-ups' visual statements so a phrase
 * never sits in ordinary body copy:
 *  - brush: handwritten phrase on a blush brush shape (WhyPanel, ContactBlock)
 *  - pull:  handwritten line with a coral heart, part of the content (StoryBlock)
 *  - quote: coral opening quote mark, statement text, attribution (PartnerStatement)
 *  - banner: large serif statement on a tinted panel (available for future pages)
 * `decorative` statements are aria-hidden; `pull` and `quote` are real content.
 */
import Handwritten from './Handwritten.astro';
import Heart from './Heart.astro';
interface Props {
  variant: 'brush' | 'pull' | 'quote' | 'banner';
  text: string;
  attribution?: string;
  tone?: 'ink' | 'white';
  tint?: 'blush' | 'sage' | 'pale-blue' | 'gold';
  size?: 'sm' | 'md' | 'lg';
  rotate?: number;
  /** quote only: render as a blockquote (a real quotation from a person, with consent) */
  asQuotation?: boolean;
  class?: string;
}
const { variant, text, attribution, tone = 'ink', tint = 'blush', size = 'md', rotate = -8, asQuotation = false, class: className = '' } = Astro.props;
---
{variant === 'brush' && (
  <div class={`st st-brush tint-${tint} ${className}`} aria-hidden="true">
    <div class="brush"></div>
    <Handwritten text={text} tone={tone} size={size} rotate={rotate} />
  </div>
)}
{variant === 'pull' && (
  <p class={`st st-pull ${className}`}><span class="script-note">{text}</span> <Heart class="st-heart" size={22} /></p>
)}
{variant === 'quote' && (asQuotation ? (
  <blockquote class={`st st-quote ${className}`}><p class="st-quote-text">{text}</p>{attribution && <footer class="st-attr">{attribution}</footer>}</blockquote>
) : (
  <div class={`st st-quote ${className}`} role="note"><p class="st-quote-text">{text}</p>{attribution && <p class="st-attr">{attribution}</p>}</div>
))}
{variant === 'banner' && (
  <div class={`st st-banner tint-${tint} ${className}`}>
    <p class="st-banner-text">{text}</p>
    {attribution && <p class="st-attr">{attribution}</p>}
  </div>
)}
<style>
  .st-brush { position: relative; width: clamp(11rem, 8rem + 6vw, 14rem); aspect-ratio: 1; display: flex; align-items: center; justify-content: center; flex: none; }
  .brush { position: absolute; inset: 0; border-radius: 58% 42% 55% 45% / 45% 55% 45% 55%; transform: rotate(-12deg); }
  .tint-blush .brush { background: var(--blush); }
  .tint-sage .brush { background: var(--sage-200); }
  .tint-pale-blue .brush { background: var(--pale-blue); }
  .tint-gold .brush { background: var(--gold); }
  .st-brush :global(.hw) { position: relative; }
  .st-pull { display: flex; align-items: flex-end; gap: 0.5rem; margin: var(--space-4) 0 0; transform: rotate(-3deg); max-width: none; }
  .st-pull .script-note { font-size: clamp(1.5rem, 1.1rem + 1.3vw, 2.1rem); }
  .st-pull :global(.st-heart) { color: var(--coral); flex: none; }
  .st-quote { position: relative; margin: 0; padding-left: 0.25rem; }
  .st-quote::before { content: '\201C'; position: absolute; left: -1.4rem; top: -1rem; font-family: var(--font-serif); font-size: 3.75rem; line-height: 1; color: var(--coral); }
  .st-quote-text { font-size: clamp(1.125rem, 1rem + 0.5vw, 1.375rem); line-height: 1.5; margin: 0 0 0.75rem; max-width: 30ch; }
  .st-attr { font-size: var(--fs-small); font-weight: 600; margin: 0; }
  .st-banner { border-radius: var(--radius-panel); padding: var(--space-5) var(--space-4); text-align: center; }
  .tint-blush.st-banner { background: var(--blush); } .tint-sage.st-banner { background: var(--sage-200); } .tint-pale-blue.st-banner { background: var(--pale-blue); } .tint-gold.st-banner { background: var(--gold); }
  .st-banner-text { font-family: var(--font-serif); font-weight: 700; font-size: var(--fs-h2); line-height: 1.15; margin: 0 auto 0.5rem; max-width: 20ch; }
  @media (max-width: 640px) { .st-quote::before { left: -0.2rem; top: -1.6rem; } .st-quote { padding-left: 0; } }
</style>
