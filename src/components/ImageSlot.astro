---
/**
 * A named photograph position. Renders the supplied image if a file named
 * `<slot>.{jpg,jpeg,png,webp,avif}` exists in src/assets/images/<page>/,
 * otherwise a tinted placeholder at exactly the same aspect ratio.
 * Children render as an overlay (used for programme card titles and accents).
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { imageSlots, type ImageSlotName, type ImageSlotDef } from '../config/images';
import Icon from './Icon.astro';

interface Props {
  name: ImageSlotName;
  class?: string;
  priority?: boolean;
  /** Render nothing at all when no image is supplied (used for the optional founder image). */
  hideIfMissing?: boolean;
  /** Fill the parent's height instead of using the slot's aspect ratio. */
  fill?: boolean;
}
const { name, class: className = '', priority = false, hideIfMissing = false, fill = false } = Astro.props;
const def: ImageSlotDef = imageSlots[name];

const files = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/images/**/*.{jpg,jpeg,png,webp,avif,JPG,JPEG,PNG}',
  { eager: true },
);
const match = Object.entries(files).find(([path]) => {
  const file = path.split('/').pop() ?? '';
  return path.includes(`/images/${def.page}/`) && file.replace(/\.[^.]+$/, '') === name;
});
const image = match?.[1].default;
const supplied = Boolean(image);
const style = `--ratio:${def.ratio}; --ratio-mobile:${def.ratioMobile ?? def.ratio}; --focal:${def.focal ?? '50% 50%'};`;
---
{(supplied || !hideIfMissing) && (
  <div class={`slot tint-${def.tint} ${fill ? 'fill' : ''} ${supplied ? 'supplied' : 'placeholder'} ${className}`} style={style} data-slot={name}>
    {supplied ? (
      <Picture
        src={image!}
        alt={def.alt}
        widths={def.widths ?? [480, 768, 1200, 1600]}
        sizes={def.sizes ?? '100vw'}
        formats={['avif', 'webp']}
        loading={priority ? 'eager' : 'lazy'}
        fetchpriority={priority ? 'high' : undefined}
        decoding="async"
        class="slot-img"
      />
    ) : (
      <div class="ph" role="presentation">
        <Icon name="image" size={28} class="ph-icon" />
        <span class="ph-label">{name} · {def.ratio.replace(/\s/g, '')}</span>
      </div>
    )}
    <slot />
  </div>
)}
<style>
  .slot { position: relative; overflow: hidden; aspect-ratio: var(--ratio); background: var(--cream-deep); }
  .slot.fill { aspect-ratio: auto; height: 100%; min-height: 100%; }
  @media (max-width: 900px) { .slot:not(.fill) { aspect-ratio: var(--ratio-mobile); } .slot.fill { aspect-ratio: var(--ratio-mobile); height: auto; } }
  .slot :global(picture), .slot :global(img.slot-img) { position: absolute; inset: 0; width: 100%; height: 100%; }
  .slot :global(img.slot-img) { object-fit: cover; object-position: var(--focal); }
  .ph { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 0.5rem; color: rgba(22, 55, 68, 0.28); }
  .ph::before { content: ''; position: absolute; inset: 0; background: radial-gradient(ellipse at 30% 25%, rgba(255,255,255,0.45), transparent 55%); }
  .ph-icon { position: relative; }
  .ph-label { position: relative; display: none; font-family: var(--font-sans); font-size: 0.75rem; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: rgba(22, 55, 68, 0.55); background: rgba(255,255,255,0.6); padding: 0.2rem 0.5rem; border-radius: 4px; }
  :global(html.show-slots) .ph-label { display: inline-block; }
  /* Over a placeholder the white handwritten accents switch to ink so they stay legible; over a photograph they are white. */
  .placeholder :global(.hw-white) { color: var(--ink); text-shadow: none; }
  .placeholder :global(.hw-white .hw-heart) { color: var(--coral); }
  .tint-sage { background: var(--sage-200); }
  .tint-blush { background: var(--blush); }
  .tint-pale-blue { background: var(--pale-blue); }
  .tint-gold { background: var(--gold); }
</style>
