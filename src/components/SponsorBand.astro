---
/**
 * Scrolling band of sponsor logos. The first copy of each logo is the real one (alt text,
 * link, focusable); the repeats that make the loop seamless sit in aria-hidden items and
 * cannot be tabbed to, so screen readers hear each sponsor once.
 * It pauses on hover, on keyboard focus and with the pause button (WCAG 2.2.2), and
 * reduced-motion users get a still, centred row of the real logos only.
 */
import { Image } from 'astro:assets';
import { sponsors } from '../config/sponsors';

// Enough repeats per set that one set is wider than the widest screen, then two sets so the
// track can slide by exactly one set and start again without a jump.
const repeats = Math.max(2, Math.ceil(8 / sponsors.length));
const set = Array.from({ length: repeats }, () => sponsors).flat();
const tiles = [...set, ...set].map((s, i) => ({ ...s, real: i < sponsors.length }));
---
<div class="band" data-sponsor-band>
  <div class="viewport">
    <ul class="track" aria-label="Our sponsors">
      {tiles.map((t) => (
        <li class:list={['tile', { repeat: !t.real }]} aria-hidden={t.real ? undefined : 'true'}>
          {t.href ? (
            <a href={t.href} rel="noopener" tabindex={t.real ? undefined : -1}>
              <Image src={t.logo} alt={`${t.name} logo`} width={560} loading="lazy" />
            </a>
          ) : (
            <Image src={t.logo} alt={`${t.name} logo`} width={560} loading="lazy" />
          )}
        </li>
      ))}
    </ul>
  </div>
  <button class="pause" type="button" aria-pressed="false" hidden>Pause logos</button>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-sponsor-band]').forEach((band) => {
    const btn = band.querySelector<HTMLButtonElement>('.pause');
    if (!btn) return;
    btn.hidden = false;
    btn.addEventListener('click', () => {
      const paused = band.classList.toggle('is-paused');
      btn.setAttribute('aria-pressed', String(paused));
      btn.textContent = paused ? 'Play logos' : 'Pause logos';
    });
  });
</script>

<style>
  .band { display: grid; gap: 1rem; justify-items: end; }
  .viewport {
    width: 100%; overflow: hidden;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
            mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
  }
  .track { list-style: none; display: flex; gap: 1.5rem; width: max-content; animation: sponsor-scroll 40s linear infinite; }
  .band:hover .track, .band:focus-within .track, .band.is-paused .track { animation-play-state: paused; }
  @keyframes sponsor-scroll { to { transform: translateX(calc(-50% - 0.75rem)); } }

  .tile { flex: none; width: clamp(220px, 18vw + 120px, 300px); aspect-ratio: 2 / 1; background: var(--logo-ground); border: 1px solid var(--dark-rule); border-radius: var(--radius-card); transition: border-color 0.2s ease; }
  .tile:hover { border-color: var(--hope-sun); }
  .tile a { display: block; height: 100%; border-radius: inherit; }
  .tile :global(img) { width: 100%; height: 100%; object-fit: contain; padding: 1.25rem 1.5rem; }

  .pause {
    min-height: 44px; padding: 0 1rem; background: transparent; color: var(--dark-text);
    border: 1px solid var(--dark-rule); border-radius: var(--radius-button);
    font: inherit; font-size: var(--fs-caption); font-weight: 600; cursor: pointer;
  }
  .pause:hover { border-color: var(--dark-caption); }

  @media (prefers-reduced-motion: reduce) {
    .viewport { -webkit-mask-image: none; mask-image: none; }
    .track { width: auto; flex-wrap: wrap; justify-content: center; }
    .repeat, .pause { display: none; }
  }
</style>
