---
/** One programme: image frame with overlaid title and status badge, summary, CTA. */
import type { CollectionEntry } from 'astro:content';
import ImageSlot from './ImageSlot.astro';
import StatusBadge from './StatusBadge.astro';
import Button from './Button.astro';
import type { ImageSlotName } from '../config/images';
interface Props { programme: CollectionEntry<'programmes'> }
const { programme } = Astro.props;
const d = programme.data;
const cta = d.hasPage ? d.futureCta : d.launchCta;
---
<article class="prog" id={`programme-${d.slug}`}>
  <div class="prog-media">
    {d.imageSlot && (
      <ImageSlot name={d.imageSlot as ImageSlotName}>
        <div class="prog-overlay">
          <StatusBadge status={d.status} class="prog-badge" />
          <h3 class="prog-title">{d.title}</h3>
        </div>
      </ImageSlot>
    )}
  </div>
  <p class="prog-summary">{d.summary}</p>
  {cta && <Button href={cta.href} label={cta.label} hiddenLabel={`: ${d.title}`} variant="text" />}
</article>
<style>
  .prog { display: flex; flex-direction: column; gap: 0.6rem; }
  .prog-media :global(.slot) { border-radius: var(--radius-card); }
  .prog-overlay { position: absolute; inset: 0; display: flex; flex-direction: column; justify-content: space-between; align-items: flex-start; padding: 0.75rem; background: linear-gradient(to top, rgba(22,55,68,0.62) 0%, rgba(22,55,68,0.15) 45%, rgba(22,55,68,0) 70%); }
  .prog-title { font-size: 1.35rem; color: var(--white); margin: 0; text-shadow: 0 1px 2px rgba(0,0,0,0.25); }
  .prog-summary { font-size: var(--fs-small); margin: 0; }
  .prog :global(.btn-text) { margin-top: auto; align-self: flex-start; }
</style>
