---
/** Let's Talk: image left, warm close with a mailto button, accent right. */
import { site } from '../config/site';
import ImageSlot from './ImageSlot.astro';
import Handwritten from './Handwritten.astro';
import Button from './Button.astro';
interface Props { heading: string; paragraph: string; cta: { label: string; hiddenLabel?: string }; accent?: string; id?: string }
const { heading, paragraph, cta, accent, id = 'together' } = Astro.props;
---
<section id={id} class="closing" aria-labelledby={`${id}-heading`}>
  <div class="closing-media"><ImageSlot name="lets-talk-detail" fill /></div>
  <div class="closing-text">
    <h2 id={`${id}-heading`}>{heading}</h2>
    <p>{paragraph}</p>
    <div class="closing-cta"><Button href={site.contact.emailHref} label={cta.label} hiddenLabel={cta.hiddenLabel} variant="primary" /></div>
  </div>
  {accent && <div class="closing-accent hide-md"><span class="rule-v"></span><Handwritten text={accent} size="md" rotate={-8} /></div>}
</section>
<style>
  .closing { display: grid; grid-template-columns: 40fr 45fr 15fr; background: var(--cream); }
  .closing-text { padding: var(--space-5) clamp(1.5rem, 1rem + 2vw, 3rem); display: flex; flex-direction: column; justify-content: center; }
  .closing-text p { max-width: 44ch; }
  .closing-cta { margin-top: var(--space-2); }
  .closing-accent { display: flex; align-items: center; gap: var(--space-3); padding-right: var(--gutter); }
  @media (max-width: 900px) { .closing { grid-template-columns: 1fr; } .closing-text { padding-inline: var(--gutter); } }
</style>
