---
/**
 * Contact details. One source of truth (site.contact). `mode`:
 *  - panel: pale panel with heading, paragraph, rows, optional safety line, brush statement (Let's Talk)
 *  - dark: rows and a button inside a teal band (About)
 */
import { site } from '../config/site';
import Icon from './Icon.astro';
import Button from './Button.astro';
import Handwritten from './Handwritten.astro';
import Statement from './Statement.astro';
interface Props { mode?: 'panel' | 'dark'; heading: string; paragraph?: string; cta?: { label: string; href: string }; accent?: string; id?: string; showSafety?: boolean }
const { mode = 'panel', heading, paragraph, cta, accent, id, showSafety = false } = Astro.props;
const { contact } = site;
---
<div id={id} class={`contact contact-${mode} ${mode === 'dark' ? 'on-dark' : ''}`}>
  <div class="contact-main">
    <h2>{heading}</h2>
    {paragraph && <p>{paragraph}</p>}
    <ul class="contact-rows">
      <li class="row">
        <span class="row-icon"><Icon name="phone" size={mode === 'panel' ? 26 : 18} strokeWidth={1.6} /></span>
        <span class="row-text">{mode === 'panel' && <span class="row-label">Phone</span>}<a href={contact.phoneHref}>{contact.phoneDisplay}</a></span>
      </li>
      <li class="row">
        <span class="row-icon"><Icon name="mail" size={mode === 'panel' ? 26 : 18} strokeWidth={1.6} /></span>
        <span class="row-text">{mode === 'panel' && <span class="row-label">Email</span>}<a href={contact.emailHref}>{contact.email}</a></span>
      </li>
    </ul>
    {showSafety && site.flags.showSafetyLine && (
      <p class="safety small"><strong>{site.safety.line}</strong> {site.safety.detail}</p>
    )}
    {cta && <div class="contact-cta"><Button href={cta.href} label={cta.label} variant="primary" /></div>}
  </div>
  {accent && (
    <div class="contact-accent accent-side">
      {mode === 'panel' ? (
        <>
          <span class="rule-v"></span>
          <Statement variant="brush" text={accent} size="md" rotate={-8} />
        </>
      ) : (
        <Handwritten text={accent} tone="white" size="lg" rotate={-8} />
      )}
    </div>
  )}
</div>
<style>
  .contact-panel { display: grid; grid-template-columns: 1.4fr 1fr; gap: var(--space-4); background: var(--pale-blue-100); border-radius: var(--radius-panel); padding: var(--space-5) var(--space-5); }
  .contact-dark { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: var(--space-3); align-items: center; }
  .contact-dark .contact-accent { max-width: 12rem; }
  .contact-rows { list-style: none; display: flex; flex-direction: column; gap: 1rem; margin-top: var(--space-3); }
  .row { display: flex; align-items: center; gap: 1rem; }
  .row-icon { display: inline-flex; align-items: center; justify-content: center; width: 58px; height: 58px; border-radius: 50%; background: var(--teal); color: var(--white); flex: none; }
  .contact-dark .row-icon { width: 32px; height: 32px; background: var(--white); color: var(--teal); }
  .row-text { display: flex; flex-direction: column; line-height: 1.25; }
  .row-label { font-size: 1.0625rem; font-weight: 600; }
  .row a { color: inherit; font-size: clamp(1.125rem, 1rem + 0.6vw, 1.5rem); text-decoration: none; min-height: 44px; display: inline-flex; align-items: center; overflow-wrap: anywhere; }
  .contact-dark .row a { font-size: 1.0625rem; }
  .row a:hover { text-decoration: underline; }
  .safety { margin-top: var(--space-3); max-width: 52ch; color: var(--text-muted); }
  .contact-cta { margin-top: var(--space-3); }
  .contact-accent { justify-content: center; }
  @media (max-width: 900px) { .contact-panel, .contact-dark { grid-template-columns: 1fr; } .contact-panel { padding: var(--space-4); } .contact-dark .contact-accent { max-width: none; } }
</style>
