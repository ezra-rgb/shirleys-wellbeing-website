---
/**
 * Shared footer. `tone` keeps each page's mock-up rhythm: light on Home and About, dark on Let's Talk.
 * Social links, legal links and the legal registration line switch on from site config when supplied.
 */
import { site } from '../config/site';
import { legalNav, primaryCta } from '../config/navigation';
import Logo from './Logo.astro';
import Button from './Button.astro';
import Icon from './Icon.astro';
import Handwritten from './Handwritten.astro';
interface Props { tone?: 'light' | 'dark'; accent?: string }
const { tone = 'light', accent = 'See the person first.' } = Astro.props;
const dark = tone === 'dark';
const showSocial = site.flags.showSocial && site.social.length > 0;
const legalLine = [site.legal.companyNumber && `Company number ${site.legal.companyNumber}`, site.legal.placeOfRegistration && `Registered in ${site.legal.placeOfRegistration}`, site.legal.registeredOffice && `Registered office: ${site.legal.registeredOffice}`].filter(Boolean).join(' | ');
---
<footer class={`site-footer ${dark ? 'footer-dark on-dark' : 'footer-light'}`}>
  <div class="container footer-main">
    <Logo tone={dark ? 'white' : 'dark'} />
    <div class="footer-centre">
      <p class="footer-brandline">{site.brandLine}</p>
      <p class="footer-desc small">{site.footerDescriptor}</p>
      <div class="footer-actions">
        <Button href={primaryCta.href} label={primaryCta.label} variant="primary" />
        {showSocial && (
          <>
            <Button href={site.social[0].href} label="Follow our journey" variant={dark ? 'secondary-dark' : 'secondary'} arrow={false} />
            <ul class="social" aria-label="Social media">
              {site.social.map((s) => (
                <li><a href={s.href} rel="noopener" target="_blank" aria-label={`${site.shortName} on ${s.label}`}><Icon name={s.network} size={20} /></a></li>
              ))}
            </ul>
          </>
        )}
      </div>
    </div>
    <Handwritten text={accent} tone={dark ? 'white' : 'ink'} size="lg" class="footer-accent" />
  </div>
  <div class="footer-legal">
    <div class="container footer-legal-inner">
      {site.flags.showLegalLinks ? (
        <ul class="legal-links">
          {legalNav.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
        </ul>
      ) : <span></span>}
      <p class="legal-text">{site.name} | {site.descriptor}{legalLine && <><br />{legalLine}</>}</p>
      <p class="legal-text">&copy; {site.copyrightYear} {site.name}</p>
    </div>
  </div>
</footer>
<style>
  .site-footer { margin-top: 0; }
  .footer-light { background: var(--cream); border-top: 1px solid var(--rule); }
  .footer-dark { background: var(--teal); color: var(--white); }
  .footer-main { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: var(--space-4); padding-block: var(--space-5); }
  .footer-centre { text-align: center; display: flex; flex-direction: column; align-items: center; gap: 0.35rem; }
  .footer-brandline { font-family: var(--font-serif); font-weight: 700; font-size: 1.25rem; margin: 0; }
  .footer-desc { margin: 0 auto; max-width: 52ch; }
  .footer-actions { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: var(--space-2); margin-top: var(--space-2); }
  .social { display: flex; gap: 0.75rem; list-style: none; }
  .social a { display: inline-flex; align-items: center; justify-content: center; width: 44px; height: 44px; border-radius: 50%; color: inherit; }
  .footer-legal { border-top: 1px solid var(--rule); }
  .footer-dark .footer-legal { background: var(--cream); color: var(--ink); border-top: 0; }
  .footer-legal-inner { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: var(--space-2); padding-block: var(--space-3); font-size: 0.8125rem; }
  .legal-links { display: flex; gap: 0.75rem; list-style: none; }
  .legal-links a { color: inherit; text-decoration: none; }
  .legal-links a:hover { text-decoration: underline; }
  .legal-text { margin: 0; text-align: center; color: inherit; }
  .legal-text:last-child { text-align: right; }
  .footer-dark .legal-text { color: var(--ink); }
  @media (max-width: 900px) {
    .footer-main { grid-template-columns: 1fr; justify-items: center; text-align: center; }
    .footer-legal-inner { grid-template-columns: 1fr; justify-items: center; }
    .legal-text:last-child { text-align: center; }
  }
</style>
