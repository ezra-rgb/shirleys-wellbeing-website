---
/**
 * Dark footer on every page: direct contact, the crisis panel, company identity,
 * legal links and the one retained tagline.
 */
import { site } from '../config/site';
import { legalNav } from '../config/navigation';
interface Props { showContact?: boolean }
const { showContact = true } = Astro.props;
const { legal } = site;
---
<footer class="site-footer tone-dark">
  <div class="container">
    <div class="footer-top">
      {showContact ? (
        <div class="footer-contact">
          <h2 class="footer-heading">Talk to us</h2>
          <p class="footer-intro">Call, text or email. You don't need to explain why you're getting in touch.</p>
          <p class="footer-line"><a class="footer-big" href={site.contact.phoneHref}>{site.contact.phoneDisplay}</a></p>
          <p class="footer-line"><a class="footer-email" href={site.contact.emailHref}>{site.contact.email}</a></p>
        </div>
      ) : (
        <div class="footer-contact">
          <p class="footer-heading-sm">{site.name}</p>
          <p class="footer-line"><a href={site.contact.phoneHref}>{site.contact.phoneDisplay}</a></p>
          <p class="footer-line"><a href={site.contact.emailHref}>{site.contact.email}</a></p>
        </div>
      )}
      <section class="crisis-panel" aria-labelledby="footer-crisis-heading">
        <h2 class="crisis-heading" id="footer-crisis-heading">{site.crisis.notEmergency}</h2>
        <ul class="crisis-list">
          {site.crisis.lines.map((l) => (
            <li>{l.label}: <a href={l.href}>{l.name}</a></li>
          ))}
        </ul>
      </section>
    </div>
    <div class="footer-legal">
      <p class="legal-line">
        {site.name}{legal.placeOfRegistration && ` · Registered in ${legal.placeOfRegistration}`}{legal.companyNumber && <>, company no. <a href={legal.companiesHouseUrl} rel="noopener">{legal.companyNumber}</a></>}{legal.registeredOffice && ` · Registered office: ${legal.registeredOffice}`}<span class="copyright"> · &copy; {site.copyrightYear}</span>
      </p>
      <nav aria-label="Legal and policies">
        <ul class="legal-links">
          {legalNav.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
        </ul>
      </nav>
    </div>
    <p class="footer-tagline">{site.tagline}</p>
  </div>
</footer>
<style>
  .site-footer { padding-block: clamp(3.5rem, 2.5rem + 3vw, 5rem) 3rem; }
  .footer-top { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 27rem); gap: var(--space-5); align-items: start; }
  .footer-heading { font-size: clamp(2rem, 1.6rem + 1.4vw, 2.5rem); margin-bottom: 0.75rem; }
  .footer-heading-sm { font-family: var(--font-head); font-weight: 800; font-size: 1.25rem; color: var(--dark-text); margin-bottom: 0.75rem; }
  .footer-intro { max-width: 26rem; margin-bottom: 1.5rem; }
  .footer-line { margin: 0; }
  .footer-line a { display: inline-flex; align-items: center; min-height: 44px; color: var(--dark-text); font-weight: 500; text-decoration: underline; }
  .footer-big { font-size: clamp(1.25rem, 1.15rem + 0.4vw, 1.5rem); }
  .footer-email { font-size: 1.125rem; word-break: break-word; }
  .crisis-panel { border: 1px solid var(--dark-rule); border-radius: var(--radius-card); padding: 1.5rem 1.25rem; }
  .crisis-heading { font-family: var(--font-body); font-weight: 650; font-size: 1.0625rem; letter-spacing: 0; margin-bottom: 0.75rem; }
  .crisis-list { list-style: none; display: grid; gap: 0; font-size: 0.9375rem; }
  .crisis-list li { line-height: 1.5; padding-block: 0.6rem; }
  .crisis-list a { color: var(--dark-text); font-weight: 700; display: inline-block; padding: 12px 10px; margin: -12px -10px; text-decoration: underline; text-decoration-color: var(--dark-rule); }
  .crisis-list a:hover { text-decoration-color: currentColor; }
  .footer-legal { display: flex; justify-content: space-between; align-items: center; gap: 0.75rem 2rem; flex-wrap: wrap; margin-top: var(--space-5); padding-top: 1.5rem; border-top: 1px solid var(--dark-rule); }
  .legal-line { margin: 0; font-size: 0.8125rem; color: var(--dark-caption); max-width: 52rem; }
  .legal-line a { color: var(--dark-secondary); }
  .legal-links { display: flex; flex-wrap: wrap; gap: 0 1.5rem; list-style: none; }
  .legal-links a { display: inline-flex; align-items: center; min-height: 44px; font-size: 0.875rem; color: var(--dark-secondary); text-decoration: underline; }
  .footer-tagline { margin: 1rem 0 0; font-family: var(--font-body); font-weight: 700; color: var(--amber); }
  @media (max-width: 860px) { .footer-top { grid-template-columns: minmax(0, 1fr); gap: var(--space-4); } }
</style>
