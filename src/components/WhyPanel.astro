---
/** About: tinted panel holding "Why people in retail?" and "Beyond the role", with the blush brush statement. */
import Statement from './Statement.astro';
interface Props { heading: string; groups: { subheading: string; paragraphs: string[] }[]; accent?: string; id?: string }
const { heading, groups, accent, id = 'why' } = Astro.props;
---
<div class="why-panel" id={id}>
  {accent && <div class="why-accent"><Statement variant="brush" text={accent} size="md" rotate={-8} /></div>}
  <h2>{heading}</h2>
  {groups.map((g) => (
    <div class="why-group">
      <h3>{g.subheading}</h3>
      {g.paragraphs.map((p) => <p class="small">{p}</p>)}
    </div>
  ))}
</div>
<style>
  .why-panel { position: relative; background: var(--pale-blue-100); border-radius: var(--radius-panel); padding: var(--space-4); overflow: hidden; }
  .why-panel h2 { max-width: 55%; }
  .why-group + .why-group { margin-top: var(--space-3); }
  .why-group h3 { font-size: 1.2rem; margin-bottom: 0.4rem; }
  .why-group p { max-width: 42ch; }
  .why-accent { position: absolute; top: var(--space-3); right: var(--space-3); }
  @media (max-width: 640px) {
    .why-panel h2 { max-width: none; }
    .why-accent { position: static; display: flex; justify-content: center; margin-bottom: var(--space-2); }
  }
</style>
